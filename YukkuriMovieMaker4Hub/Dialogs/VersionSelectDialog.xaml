<Window x:Class="YukkuriMovieMaker4Hub.VersionSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="{Binding DialogTitle}" MinWidth="580" MinHeight="540"
        Width="680" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,8">
                <Path DockPanel.Dock="Left" Data="M6,2A3,3 0 0,1 9,5C9,6.28 8.19,7.38 7.06,7.82C7.15,8.09 7.2,8.34 7.2,8.6C7.2,10 5.96,11.2 4.8,11.97V14.03C6.24,14.39 7.2,15.66 7.2,17.2C7.2,19 5.96,20 4.8,20C3.64,20 2,19 2,17.2C2,15.66 2.96,14.39 4.4,14.03V11.97C2.96,11.61 2,10.34 2,8.6C2,6.8 3.64,5.8 4.8,5.8C4.9,5.8 5,5.81 5.1,5.82C5.04,5.55 5,5.28 5,5A3,3 0 0,1 8,2M6,17.2C6,16.36 5.44,15.8 4.8,15.8C4.16,15.8 3.6,16.36 3.6,17.2C3.6,18 4.16,18.6 4.8,18.6C5.44,18.6 6,18 6,17.2M4.8,7.4C4.16,7.4 3.6,8 3.6,8.6C3.6,9.24 4.16,9.8 4.8,9.8C5.44,9.8 6,9.24 6,8.6C6,8 5.44,7.4 4.8,7.4M16.8,5.8C15.64,5.8 14.4,6.8 14.4,8.6C14.4,10.34 15.36,11.61 16.8,11.97V22H18.4V11.97C19.84,11.61 20.8,10.34 20.8,8.6C20.8,6.8 19.16,5.8 17.2,5.8H16.8M18.4,7.4C19.04,7.4 19.6,8 19.6,8.6C19.6,9.24 19.04,9.8 18.4,9.8C17.76,9.8 17.2,9.24 17.2,8.6C17.2,8 17.76,7.4 18.4,7.4Z"
                      Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding DialogTitle}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="4">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- Header -->
        <DockPanel Grid.Row="1" Margin="16,16,16,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="{Binding Plugin.Name}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBlock Text=" by " FontSize="16" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <TextBlock Text="{Binding Plugin.Author}" FontSize="16" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Hyperlink Click="OpenGitHub_Click" TextDecorations="None">
                    <TextBlock Text="{x:Static local:Translate.ViewAllReleasesOnGitHub}" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Cursor="Hand"/>
                </Hyperlink>
            </TextBlock>
            <Grid/>
        </DockPanel>

        <!-- Version tags area -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,0,16,16">
            <WrapPanel x:Name="VersionTagsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Selected version detail area -->
        <Border Grid.Row="3" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Margin="16,0,16,16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="ReleaseNameText" DockPanel.Dock="Left" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <Border x:Name="TagBadge" DockPanel.Dock="Left" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TagText" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    </Border>
                    <Path DockPanel.Dock="Left" Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,13H12V18H17V13Z" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="DateText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>

                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="DownloadSourceZip_Click" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static local:Translate.DirectDownloadNote}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        </StackPanel>
                    </Button>
                    <Grid/>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="{x:Static local:Translate.ReleaseList}" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Margin="0,0,0,16">
                    <WebBrowser x:Name="ReleaseBrowser" Height="180"/>
                </Border>

                <TextBlock Grid.Row="3" x:Name="AssetsCountText" Text="{x:Static local:Translate.DownloadFilesList}" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <ItemsControl Grid.Row="4" x:Name="AssetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Tag="{Binding}" Click="DownloadAsset_Click" Padding="12,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{x:Static local:Translate.Download}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                        </StackPanel>
                                    </Button>
                                    <Grid/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Bottom -->
        <Border Grid.Row="4" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
                <Button Click="Select_Click" Padding="24,6" Margin="0,0,8,0">
                    <TextBlock Text="{x:Static local:Translate.Download}" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                </Button>
                <Button Click="Close_Click" Padding="24,6">
                    <TextBlock Text="{x:Static local:Translate.Close}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
