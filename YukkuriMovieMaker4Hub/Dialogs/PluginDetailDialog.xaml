<Window x:Class="YukkuriMovieMaker4Hub.PluginDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="{x:Static local:Translate.PluginDetailTitle}" MinWidth="600" MinHeight="520"
        Width="720" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" Padding="6,2" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayType}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" FontWeight="Bold" FontSize="11"/>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                           VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           TextTrimming="CharacterEllipsis"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Close_Click"
                        Background="Transparent" BorderThickness="0" Padding="4">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                          Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- Body: Tab Control -->
        <TabControl Grid.Row="1" x:Name="DetailTabControl" Margin="10" SelectionChanged="DetailTabControl_SelectionChanged"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            
            <!-- タブ 1: 概要 / 関連リンク -->
            <TabItem Header="{x:Static local:Translate.OverviewAndLinks}" x:Name="OverviewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                    <StackPanel>
                        <!-- 作者 & バージョン & 公開日 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                  Fill="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Author}" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>

                            <Path Data="M6,2A3,3 0 0,1 9,5C9,6.28 8.19,7.38 7.06,7.82C7.15,8.09 7.2,8.34 7.2,8.6C7.2,10 5.96,11.2 4.8,11.97V14.03C6.24,14.39 7.2,15.66 7.2,17.2C7.2,19 5.96,20 4.8,20C3.64,20 2,19 2,17.2C2,15.66 2.96,14.39 4.4,14.03V11.97C2.96,11.61 2,10.34 2,8.6C2,6.8 3.64,5.8 4.8,5.8C4.9,5.8 5,5.81 5.1,5.82C5.04,5.55 5,5.28 5,5A3,3 0 0,1 8,2M6,17.2C6,16.36 5.44,15.8 4.8,15.8C4.16,15.8 3.6,16.36 3.6,17.2C3.6,18 4.16,18.6 4.8,18.6C5.44,18.6 6,18 6,17.2M4.8,7.4C4.16,7.4 3.6,8 3.6,8.6C3.6,9.24 4.16,9.8 4.8,9.8C5.44,9.8 6,9.24 6,8.6C6,8 5.44,7.4 4.8,7.4M16.8,5.8C15.64,5.8 14.4,6.8 14.4,8.6C14.4,10.34 15.36,11.61 16.8,11.97V22H18.4V11.97C19.84,11.61 20.8,10.34 20.8,8.6C20.8,6.8 19.16,5.8 17.2,5.8H16.8M18.4,7.4C19.04,7.4 19.6,8 19.6,8.6C19.6,9.24 19.04,9.8 18.4,9.8C17.76,9.8 17.2,9.24 17.2,8.6C17.2,8 17.76,7.4 18.4,7.4Z"
                                  Fill="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static local:Translate.VersionPrefix}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            <TextBlock Text="{Binding LatestVersionName}" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" FontWeight="Bold"/>

                            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,13H12V18H17V13Z"
                                  Fill="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DisplayPublishedAt}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        </StackPanel>

                        <!-- 説明 -->
                        <TextBlock Text="{x:Static local:Translate.DescriptionOverview}" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1" Padding="10" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        </Border>

                        <!-- 関連リンク -->
                        <TextBlock Text="{x:Static local:Translate.RelatedLinks}" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        <ContentControl x:Name="LinksList"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- タブ 2: GitHub README.md -->
            <TabItem Header="GitHub README" x:Name="GitHubReadmeTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="GitHubStatusText" Text="{x:Static local:Translate.Loading}" Margin="8,6" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <WebBrowser x:Name="GitHubReadmeBrowser"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- タブ 3: BOOTH 商品説明 -->
            <TabItem Header="{x:Static local:Translate.BoothDescription}" x:Name="BoothTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="BoothStatusText" Text="{x:Static local:Translate.Loading}" Margin="8,6" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <WebBrowser x:Name="BoothBrowser"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom bar (固定領域: WebBrowserが重ならない独立Row) -->
        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,10">
                <Button DockPanel.Dock="Left" Click="AddToSelection_Click" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M10,17L5,12L6.41,10.58L10,14.17L17.59,6.58L19,8M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z"
                              Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static local:Translate.AddToQueue}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    </StackPanel>
                </Button>
                
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="VersionSelectButton" Click="OpenVersionSelect_Click" Padding="14,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M6,2A3,3 0 0,1 9,5C9,6.28 8.19,7.38 7.06,7.82C7.15,8.09 7.2,8.34 7.2,8.6C7.2,10 5.96,11.2 4.8,11.97V14.03C6.24,14.39 7.2,15.66 7.2,17.2C7.2,19 5.96,20 4.8,20C3.64,20 2,19 2,17.2C2,15.66 2.96,14.39 4.4,14.03V11.97C2.96,11.61 2,10.34 2,8.6C2,6.8 3.64,5.8 4.8,5.8C4.9,5.8 5,5.81 5.1,5.82C5.04,5.55 5,5.28 5,5A3,3 0 0,1 8,2M6,17.2C6,16.36 5.44,15.8 4.8,15.8C4.16,15.8 3.6,16.36 3.6,17.2C3.6,18 4.16,18.6 4.8,18.6C5.44,18.6 6,18 6,17.2M4.8,7.4C4.16,7.4 3.6,8 3.6,8.6C3.6,9.24 4.16,9.8 4.8,9.8C5.44,9.8 6,9.24 6,8.6C6,8 5.44,7.4 4.8,7.4M16.8,5.8C15.64,5.8 14.4,6.8 14.4,8.6C14.4,10.34 15.36,11.61 16.8,11.97V22H18.4V11.97C19.84,11.61 20.8,10.34 20.8,8.6C20.8,6.8 19.16,5.8 17.2,5.8H16.8M18.4,7.4C19.04,7.4 19.6,8 19.6,8.6C19.6,9.24 19.04,9.8 18.4,9.8C17.76,9.8 17.2,9.24 17.2,8.6C17.2,8 17.76,7.4 18.4,7.4Z"
                                  Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static local:Translate.SelectVersion}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Close_Click" Padding="18,6">
                        <TextBlock Text="{x:Static local:Translate.Close}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
