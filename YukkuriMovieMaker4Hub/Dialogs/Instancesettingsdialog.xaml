<Window x:Class="YukkuriMovieMaker4Hub.InstanceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="YukkuriMovieMaker4Hub"
        Height="360" Width="380" MinHeight="300" MinWidth="340"
        Background="{DynamicResource ThemeBrush}"
        FontFamily="{DynamicResource AppFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <FontFamily x:Key="AppFont">Yu Gothic UI, Segoe UI, sans-serif</FontFamily>
        <SolidColorBrush x:Key="ThemeBrush"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ItemBrush"    Color="#E5E5E5"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#0078D4"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#000000"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#CCCCCC"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <TextBlock Grid.Row="0" Text="{x:Static local:Translate.InstanceSettingsDialogTitle}" FontSize="14" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}"/>

        <!-- フォーム項目 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- インスタンス名 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static local:Translate.InstanceName}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

                    <!-- YMM4パス -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static local:Translate.ExePathLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExePathTextBox" Height="26" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Click="BrowseExe_Click" Height="26" Margin="2,0,0,0" ToolTip="{x:Static local:Translate.Browse}">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                  Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"/>
                        </Button>
                    </Grid>

                    <!-- アイコン -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static local:Translate.IconLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IconPathTextBox" Height="26" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Click="BrowseIcon_Click" Height="26" Margin="2,0,0,0" ToolTip="{x:Static local:Translate.SelectIconTitle}">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                  Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- データを引き継ぐボタン -->
                <Button Click="InheritSettings_Click" Content="{x:Static local:Translate.ReInheritSettings}" HorizontalAlignment="Right" Padding="12,4" Height="26" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 最下部：保存ボタン -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Button Click="Save_Click" Content="{x:Static local:Translate.Save}" HorizontalAlignment="Right" Padding="20,4" Height="26"/>
        </Grid>
    </Grid>
</Window>
