<Window x:Class="YukkuriMovieMaker4Hub.HubUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="YukkuriMovieMaker4Hub" Height="560" Width="680" MinHeight="420" MinWidth="500"
        Background="{DynamicResource ThemeBrush}"
        FontFamily="{DynamicResource AppFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <FontFamily x:Key="AppFont">Yu Gothic UI, Segoe UI, sans-serif</FontFamily>
        <SolidColorBrush x:Key="ThemeBrush"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ItemBrush"    Color="#E5E5E5"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#0078D4"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#000000"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#CCCCCC"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <TextBlock x:Name="DialogTitleText" Grid.Row="0" Text="{x:Static local:Translate.HubUpdateAvailable}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>

        <!-- バージョン情報バナー -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="12,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:Translate.CurrentVersionLabel}" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0"/>
                <TextBlock x:Name="CurrentVersionText" FontWeight="Bold" Margin="0,0,16,0"/>
                <TextBlock Text="→" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,16,0"/>
                <TextBlock Text="{x:Static local:Translate.LatestVersionLabel}" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0"/>
                <TextBlock x:Name="LatestVersionText" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Border>

        <!-- README表示 (WebBrowser) -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="StatusText" Text="{x:Static local:Translate.ReadmeLoading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
                <WebBrowser x:Name="ReadmeBrowser"/>
            </Grid>
        </Border>

        <!-- 下部アクションバー -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 次から表示しない -->
            <CheckBox x:Name="DoNotShowAgainCheckBox" Grid.Column="0" Content="{x:Static local:Translate.DoNotShowAgain}"
                      VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>

            <!-- アクションボタン -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Click="Close_Click" Content="{x:Static local:Translate.Close}" Height="28" Padding="16,0" Margin="0,0,8,0"/>
                <Button x:Name="UpdateButton" Click="Update_Click" Content="{x:Static local:Translate.UpdateNow}" Height="28" Padding="20,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
