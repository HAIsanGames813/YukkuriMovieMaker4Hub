<Window x:Class="YukkuriMovieMaker4Hub.BulkDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="YukkuriMovieMaker4Hub" Height="480" Width="440" MinHeight="380" MinWidth="340"
        Background="{DynamicResource ThemeBrush}"
        FontFamily="{DynamicResource AppFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <FontFamily x:Key="AppFont">Yu Gothic UI, Segoe UI, sans-serif</FontFamily>
        <SolidColorBrush x:Key="ThemeBrush"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ItemBrush"    Color="#E5E5E5"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#0078D4"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#000000"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#CCCCCC"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上部：選択したプラグイン -->
        <TextBlock Grid.Row="0" Text="選択したプラグイン" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}"/>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
            <ListBox ItemsSource="{Binding TargetPlugins}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,2"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </CheckBox>
                            <TextBlock Grid.Row="1" Text="{Binding AuthorAndVersion}"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="11" Margin="22,1,0,3"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 下部：インストール先のインスタンス -->
        <TextBlock Grid.Row="2" Text="インストール先のインスタンス" Margin="0,8,0,4" Foreground="{DynamicResource TextBrush}"/>

        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
            <ListBox ItemsSource="{Binding Instances}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,2"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="2,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 右下：ダウンロードボタン -->
        <Button Grid.Row="4" Click="Ok_Click" HorizontalAlignment="Right" Margin="0,8,0,0"
                Height="28" Padding="12,0" Cursor="Hand">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                      Fill="{DynamicResource TextBrush}" Width="12" Height="12"
                      Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="ダウンロード" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
