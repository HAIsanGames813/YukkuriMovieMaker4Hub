<Window x:Class="YukkuriMovieMaker4Hub.SettingsInheritDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="YukkuriMovieMaker4Hub"
        Height="400" Width="380" MinHeight="320" MinWidth="340"
        Background="{DynamicResource ThemeBrush}"
        FontFamily="{DynamicResource AppFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <FontFamily x:Key="AppFont">Yu Gothic UI, Segoe UI, sans-serif</FontFamily>
        <SolidColorBrush x:Key="ThemeBrush"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ItemBrush"    Color="#E5E5E5"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#0078D4"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#000000"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#CCCCCC"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <TextBlock Grid.Row="0" Text="データを引き継ぐ" FontSize="14" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>

        <!-- 引き継ぎ元選択 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="引き継ぎ元" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SourceInstanceComboBox" Grid.Column="1" Height="26"
                      DisplayMemberPath="Name"
                      SelectionChanged="SourceInstanceComboBox_SelectionChanged"/>
        </Grid>

        <!-- データ一覧ラベル -->
        <TextBlock Grid.Row="2" Text="データ一覧" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}"/>

        <!-- データ一覧枠 -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FileList" Margin="6,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Margin="2,3"
                                      Foreground="{DynamicResource TextBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 最下部：実行ボタン -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="ExecuteButton" Click="Execute_Click" Content="実行"
                    HorizontalAlignment="Right" Padding="16,4" Height="26"/>
        </Grid>
    </Grid>
</Window>
