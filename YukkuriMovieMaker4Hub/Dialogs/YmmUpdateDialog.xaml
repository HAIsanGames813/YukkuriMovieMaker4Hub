<Window x:Class="YukkuriMovieMaker4Hub.YmmUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="YukkuriMovieMaker4Hub" Height="500" Width="600" MinHeight="380" MinWidth="450"
        Background="{DynamicResource ThemeBrush}"
        FontFamily="{DynamicResource AppFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <FontFamily x:Key="AppFont">Yu Gothic UI, Segoe UI, sans-serif</FontFamily>
        <SolidColorBrush x:Key="ThemeBrush"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ItemBrush"    Color="#E5E5E5"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#0078D4"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#000000"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#CCCCCC"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <TextBlock Grid.Row="0" Text="{x:Static local:Translate.Ymm4UpdateAvailable}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>

        <!-- バージョン情報バナー -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="12,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:Translate.InstanceLabel}" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0"/>
                <TextBlock x:Name="InstanceNameText" FontWeight="Bold" Margin="0,0,16,0"/>
                <TextBlock Text="{x:Static local:Translate.CurrentLabel}" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0"/>
                <TextBlock x:Name="CurrentVersionText" FontWeight="Bold" Margin="0,0,16,0"/>
                <TextBlock Text="→" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,16,0"/>
                <TextBlock Text="{x:Static local:Translate.LatestLabel}" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0"/>
                <TextBlock x:Name="LatestVersionText" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Border>

        <!-- 更新履歴一覧 -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <ItemsControl x:Name="UpdatesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded}" BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="0,0,0,1" Padding="0,8,0,12" Margin="0,0,0,8">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding CleanDescription}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource SubTextBrush}" FontSize="12" LineHeight="18"/>
                                    <Button Click="OpenReleaseUrl_Click" Tag="{Binding ArticleUrl}" HorizontalAlignment="Left" Padding="10,3" Height="26" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" Fill="{DynamicResource TextBrush}"
                                                  Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                                            <TextBlock Text="{x:Static local:Translate.OpenWebPage}" VerticalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 下部ボタンエリア -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Click="OpenManjubox_Click" Padding="14,4" Height="28" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" Fill="{DynamicResource TextBrush}"
                          Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                    <TextBlock Text="{x:Static local:Translate.OpenYmm4OfficialPage}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Click="Close_Click" Content="{x:Static local:Translate.Close}" Width="80" Height="28" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
