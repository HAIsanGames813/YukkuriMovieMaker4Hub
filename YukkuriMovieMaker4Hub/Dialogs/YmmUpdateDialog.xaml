<Window x:Class="YukkuriMovieMaker4Hub.YmmUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="{x:Static local:Translate.UpdateDetails}"
        Height="600" Width="640"
        Background="{DynamicResource ThemeBrush}"
        FontFamily="{DynamicResource AppFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
        <SolidColorBrush x:Key="ThemeBrush"   Color="#252525"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#333333"/>
        <SolidColorBrush x:Key="ItemBrush"    Color="#444444"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#2E7D32"/>
        <SolidColorBrush x:Key="TextBrush"    Color="White"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#555555"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Text="{x:Static local:Translate.UpdateDetails}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- バージョン情報 -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CurrentVersionText" FontSize="13"
                           Foreground="{DynamicResource SubTextBrush}" Margin="0,0,16,0"/>
                <TextBlock Text="→" FontSize="13" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,16,0"/>
                <TextBlock x:Name="LatestVersionText" FontSize="13"
                           Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                <TextBlock x:Name="UpToDateText" FontSize="13"
                           Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- リリースノート一覧（スクロール） -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="UpdateList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="14,10"
                                Background="{DynamicResource PanelBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel>
                                <!-- バージョン番号 + 日付 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="{DynamicResource AccentBrush}"
                                            Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                   FontSize="13" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding DateText}" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- 変更内容 -->
                                <TextBlock Text="{Binding CleanDescription}"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"
                                           LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 閉じるボタン -->
        <Button Grid.Row="3" Content="{x:Static local:Translate.Close}"
                Click="Close_Click" HorizontalAlignment="Right"
                Padding="24,8" Margin="0,14,0,0"
                Background="{DynamicResource ItemBrush}" Foreground="{DynamicResource TextBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
    </Grid>
</Window>