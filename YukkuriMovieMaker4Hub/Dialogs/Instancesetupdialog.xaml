<Window x:Class="YukkuriMovieMaker4Hub.InstanceSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        Title="YukkuriMovieMaker4Hub" Height="360" Width="380" MinHeight="300" MinWidth="340"
        Background="{DynamicResource ThemeBrush}"
        FontFamily="{DynamicResource AppFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <FontFamily x:Key="AppFont">Yu Gothic UI, Segoe UI, sans-serif</FontFamily>
        <SolidColorBrush x:Key="ThemeBrush"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ItemBrush"    Color="#E5E5E5"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#0078D4"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#000000"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#CCCCCC"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <TextBlock Grid.Row="0" Text="インスタンスを追加" FontSize="14" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>

        <!-- モード選択 -->
        <ComboBox x:Name="ModeComboBox" Grid.Row="1" SelectedIndex="0" Height="26" Margin="0,0,0,12" SelectionChanged="ModeComboBox_SelectionChanged">
            <ComboBoxItem Content="新規追加"/>
            <ComboBoxItem Content="既存追加"/>
        </ComboBox>

        <!-- フォーム項目 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- インスタンス名 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="インスタンス名" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Text="名前" Height="26" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

                <!-- 新規時：エディション -->
                <TextBlock x:Name="EditionLabel" Grid.Row="1" Grid.Column="0" Text="エディション" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox x:Name="EditionComboBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Height="26" Margin="0,0,0,8">
                    <ComboBoxItem Content="通常版"/>
                    <ComboBoxItem Content="Lite版"/>
                </ComboBox>

                <!-- 既存時：YMM4パス -->
                <TextBlock x:Name="ExePathLabel" Grid.Row="1" Grid.Column="0" Text="YMM4パス" VerticalAlignment="Center" Margin="0,0,8,8" Visibility="Collapsed"/>
                <Grid x:Name="ExePathPanel" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExePathTextBox" Height="26" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Click="BrowseExe_Click" Height="26" Margin="2,0,0,0" ToolTip="参照">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                              Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"/>
                    </Button>
                </Grid>

                <!-- アイコン -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="アイコン" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox x:Name="IconTypeComboBox" Grid.Row="2" Grid.Column="1" SelectedIndex="0" Height="26" Margin="0,0,0,8" SelectionChanged="IconTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="画像"/>
                    <ComboBoxItem Content="単色"/>
                    <ComboBoxItem Content="デフォルト"/>
                </ComboBox>

                <!-- アイコン詳細：画像パス -->
                <Grid x:Name="IconImagePanel" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconPathTextBox" Text="C:\" Height="26" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Click="BrowseIcon_Click" Height="26" Margin="2,0,0,0" ToolTip="画像を参照">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                              Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"/>
                    </Button>
                </Grid>

                <!-- アイコン詳細：単色 -->
                <Border x:Name="IconColorPanel" Grid.Row="3" Grid.Column="1" Height="26" Margin="0,0,0,8" Visibility="Collapsed"
                        Background="#D48800" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2"
                        Cursor="Hand" MouseLeftButtonDown="SelectColor_Click" ToolTip="クリックして色を選択"/>
            </Grid>
        </ScrollViewer>

        <!-- 下部アクション -->
        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,8,0,0">
            <ProgressBar x:Name="DownloadProgressBar" Height="4" Visibility="Collapsed" Margin="0,0,0,4"/>
            <TextBlock x:Name="DownloadStatusText" Visibility="Collapsed" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource SubTextBrush}"/>
            <Grid>
                <Button x:Name="DownloadButton" Click="Download_Click" HorizontalAlignment="Right" Padding="12,4" Height="26">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" Fill="{DynamicResource TextBrush}"
                              Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                        <TextBlock Text="ダウンロード" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Click="Add_Click" Content="追加" Visibility="Collapsed" HorizontalAlignment="Right" Padding="20,4" Height="26"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
