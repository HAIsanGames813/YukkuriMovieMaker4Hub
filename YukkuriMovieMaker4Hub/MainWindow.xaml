<Window x:Class="YukkuriMovieMaker4Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker4Hub"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="RootWindow"
        Title="{Binding HubTitle}" Height="640" Width="960" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <local:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
        <local:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <local:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <local:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InstalledVersionConverter x:Key="InstalledVersionConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:MaskedPathConverter x:Key="MaskedPathConverter"/>

        <!-- トグルラッチスタイル: YMM4仕様の半透明スタイル、ON=水色(#0078D4)、不透明度60% -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="20" Background="Transparent" Cursor="Hand">
                            <Border x:Name="Track" CornerRadius="10"
                                    Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    Opacity="0.6"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16"
                                     Fill="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                                     Opacity="0.9"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="Track" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="20,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- プラグインカードスタイル: カスタムテーマ色 -->
        <Style x:Key="PortalCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ItemBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- タグBorderスタイル -->
        <Style x:Key="TagBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- サイドバーグループ -->
        <Style x:Key="SideGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- アイコンPath用スタイル: テーマテキスト色に追従 -->
        <Style x:Key="MdiIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <!-- テーマカラーブラシ (ApplyTheme() から動的に更新される) -->
        <SolidColorBrush x:Key="ThemeBrush" Color="#252525"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#333333"/>
        <SolidColorBrush x:Key="ItemBrush" Color="#444444"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#555555"/>
        <FontFamily x:Key="AppFont">Yu Gothic UI, Segoe UI, sans-serif</FontFamily>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="InstancePanelColumn" Width="200" MinWidth="150" MaxWidth="400"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側：インスタンス管理パネル -->
        <Grid Grid.Column="0" MinHeight="300">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static local:Translate.Instance}" Margin="10,8" FontWeight="Bold" FontSize="13"/>

            <!-- インスタンス一覧 -->
            <ListBox x:Name="InstanceListBox" Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                     BorderThickness="0" Margin="4,0" AllowDrop="True"
                     PreviewMouseLeftButtonDown="InstanceList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="InstanceList_PreviewMouseMove"
                     Drop="InstanceList_Drop">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Image Stretch="Uniform" Width="24" Height="24" Source="{Binding IconImage}"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                            <Button Grid.Column="2" Click="InstanceLaunch_Click" Width="28" Height="28"
                                    Padding="0" ToolTip="{x:Static local:Translate.Launch}">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                      Fill="{DynamicResource TextBrush}"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 下部：+/-ボタン -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="6,6,6,6">
                <Button Click="AddInstance_Click" Width="28" Height="28" Margin="0,0,4,0"
                        ToolTip="{x:Static local:Translate.Add}">
                    <Path Stretch="Uniform" Width="12" Height="12"
                          Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource TextBrush}"/>
                </Button>
                <Button Click="DeleteInstance_Click" Width="28" Height="28"
                        ToolTip="{x:Static local:Translate.Delete}">
                    <Path Stretch="Uniform" Width="12" Height="12"
                          Data="M19,13H5V11H19V13Z"
                          Fill="{DynamicResource TextBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- グリッパー -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Cursor="SizeWE"
                      DragCompleted="InstancePanelSplitter_DragCompleted"/>

        <!-- 右側：メインコンテンツ -->
        <Grid Grid.Column="2" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- ポータル選択バー（選択時のみ表示） -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" SelectionChanged="TabControl_SelectionChanged">

                <!-- 1. 起動タブ -->
                <TabItem Header="起動">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 選択中インスタンス表示 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Stretch="Uniform" Width="48" Height="48"
                                       Source="{Binding SelectedInstance.IconImage}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedInstance.ExePath}" Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HideExePath}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- アクションボタン群（起動・前回・新規は左に、設定・フォルダは右端追従） -->
                        <DockPanel Grid.Row="1" Margin="0,0,0,16" LastChildFill="False">
                            <!-- 右端追従ボタン -->
                            <Button DockPanel.Dock="Right" Click="OpenFolder_Click"
                                    IsEnabled="{Binding SelectedInstance.IsRealInstance}"
                                    Width="42" Height="42" Margin="0,0,0,8"
                                    ToolTip="フォルダを開く">
                                <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                      Stretch="Uniform" Width="18" Height="18"
                                      Fill="{DynamicResource TextBrush}"/>
                            </Button>
                            <Button DockPanel.Dock="Right" Click="InstanceSettings_Click"
                                    IsEnabled="{Binding SelectedInstance.IsRealInstance}"
                                    Width="42" Height="42" Margin="0,0,8,8"
                                    ToolTip="設定">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                      Stretch="Uniform" Width="18" Height="18"
                                      Fill="{DynamicResource TextBrush}"/>
                            </Button>
                            <!-- 左側ボタン群 -->
                            <Button Click="LaunchInstance_Click"
                                    IsEnabled="{Binding SelectedInstance.IsRealInstance}"
                                    Height="42" Padding="14,0" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                          Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                          Fill="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{x:Static local:Translate.Launch}" FontSize="14"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="LaunchLastProject_Click"
                                    IsEnabled="{Binding SelectedInstance.IsRealInstance}"
                                    Height="42" Padding="14,0" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                          Data="M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z"
                                          Fill="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{x:Static local:Translate.OpenLastProject}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="CreateNewProject_Click"
                                    IsEnabled="{Binding SelectedInstance.IsRealInstance}"
                                    Height="42" Padding="14,0" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                          Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                          Fill="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{x:Static local:Translate.CreateNew}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- プロジェクト検索＆フィルター -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center"
                                     Tag="{x:Static local:Translate.SearchProject}"/>

                            <ToggleButton x:Name="ProjectFilterButton" Grid.Column="1"
                                          Height="32" Width="90" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                          Data="M6,13H18V11H6M3,6V8H21V6M10,18H14V16H10V18Z"
                                          Fill="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{x:Static local:Translate.Filter}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsChecked, ElementName=ProjectFilterButton}"
                                   StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=ProjectFilterButton}"
                                   Placement="Bottom">
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        Padding="12"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static local:Translate.FileFormat}"
                                                   FontWeight="Bold" Margin="0,0,0,8"/>
                                        <CheckBox Content=".ymmp" IsChecked="{Binding ShowYmmp}" Margin="0,2"/>
                                        <CheckBox Content=".ymmpx" IsChecked="{Binding ShowYmmpx}" Margin="0,2"/>
                                        <CheckBox Content=".ymmx" IsChecked="{Binding ShowYmmx}" Margin="0,2"/>
                                        <Separator Margin="0,8"/>
                                        <TextBlock Text="{x:Static local:Translate.Location}"
                                                   FontWeight="Bold" Margin="0,0,0,8"/>
                                        <CheckBox Content="{x:Static local:Translate.IncludeBackup}"
                                                  IsChecked="{Binding ShowBackup}" Margin="0,2"/>
                                        <Separator Margin="0,8"/>
                                        <Button Content="{x:Static local:Translate.ClearFilter}"
                                                Click="ResetProjectFilters_Click" Padding="8,4"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- プロジェクト一覧 DataGrid（行高変更不可） -->
                        <DataGrid x:Name="ProjectGrid" Grid.Row="3"
                                  ItemsSource="{Binding FilteredProjects}"
                                  MouseDoubleClick="OpenProject_Click"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static local:Translate.FileName}"
                                                    Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{x:Static local:Translate.LastUpdate}"
                                                    Binding="{Binding LastWriteTime, StringFormat='yyyy/MM/dd HH:mm'}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="{x:Static local:Translate.Size}"
                                                    Binding="{Binding DisplaySize}" Width="100"/>
                                <DataGridTextColumn Header="{x:Static local:Translate.Extension}"
                                                    Binding="{Binding Extension}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 2. プラグインリストタブ -->
                <TabItem Header="プラグインリスト">
                    <Grid IsEnabled="{Binding SelectedInstance, Converter={StaticResource IsNotNullConverter}}"
                          Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 検索＆操作ヘッダー -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static local:Translate.InstanceLabel}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedInstance.Name}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"/>
                            <TextBlock Text="{x:Static local:Translate.SearchLabel}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Width="140" Height="28"
                                     Text="{Binding LocalPluginSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0"/>

                            <!-- ローカルソート用ComboBox -->
                            <TextBlock Text="ソート:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox SelectedIndex="{Binding LocalPluginSortIndex}"
                                      SelectionChanged="LocalPluginSort_Changed"
                                      Height="28" Width="100" Margin="0,0,4,0">
                                <ComboBoxItem Content="名前"/>
                                <ComboBoxItem Content="状態"/>
                                <ComboBoxItem Content="作者"/>
                                <ComboBoxItem Content="タイプ"/>
                                <ComboBoxItem Content="バージョン"/>
                                <ComboBoxItem Content="公開日"/>
                                <ComboBoxItem Content="DL日時"/>
                            </ComboBox>
                            <Button Width="28" Height="28" Margin="0,0,8,0"
                                    Click="LocalPluginSortOrder_Click"
                                    ToolTip="昇順/降順">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Data="M10,13V11H18V13H10M10,19V17H14V19H10M10,7V5H22V7H10M6,17H8.5L5,20.5L1.5,17H4V7H1.5L5,3.5L8.5,7H6V17Z"
                                      Fill="{DynamicResource TextBrush}"/>
                            </Button>

                            <Button Click="BulkToggle_Click"
                                    Content="{x:Static local:Translate.EnableDisableSelected}"
                                    Height="28" Padding="10,0" Margin="0,0,6,0"/>
                            <Button Click="BulkDelete_Click"
                                    Content="{x:Static local:Translate.DeleteSelected}"
                                    Height="28" Padding="10,0" Margin="0,0,6,0"/>
                            <Button Click="OpenPluginDirectoryRoot_Click" Height="28" Padding="10,0"
                                    ToolTip="{x:Static local:Translate.OpenPluginFolder}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                          Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                          Fill="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{x:Static local:Translate.FolderButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- 表形式プラグイン一覧 -->
                        <ListView x:Name="LocalPluginList" Grid.Row="1" ItemsSource="{Binding LocalPlugins}"
                                  GridViewColumnHeader.Click="LocalPluginHeader_Click">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="180" Header="{x:Static local:Translate.PluginName}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="70" Header="{x:Static local:Translate.StatusColumn}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Click="TogglePlugin_Click" Cursor="Hand"
                                                          HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="64" Header="{x:Static local:Translate.Delete}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Click="DeletePlugin_Click" Width="26" Height="22"
                                                        Padding="0" HorizontalAlignment="Center">
                                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                          Stretch="Uniform" Width="12" Height="12"
                                                          Fill="{DynamicResource TextBrush}"/>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="110" Header="{x:Static local:Translate.TypeColumn}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayType}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SubTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="120" Header="{x:Static local:Translate.AuthorColumn}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Author}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="90" Header="{x:Static local:Translate.VersionColumn}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Version}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="110" Header="{x:Static local:Translate.PublishedAt}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayPublishedAt}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SubTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="120" Header="{x:Static local:Translate.DownloadedAt}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayDownloadedAt}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SubTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="50" Header="フォルダ">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Click="OpenLocalPluginFolder_Click" Width="26" Height="22"
                                                        Padding="0" HorizontalAlignment="Center">
                                                    <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                                          Stretch="Uniform" Width="12" Height="12"
                                                          Fill="{DynamicResource TextBrush}"/>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- 3. プラグインポータルタブ (HAIsanGames813/YMM4PluginPortal 準拠) -->
                <TabItem Header="プラグインポータル">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" MinWidth="190" MaxWidth="320"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左サイドバー -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4">

                                    <!-- 1. クイック一括選択 -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <StackPanel>
                                            <TextBlock Text="一括選択" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Click="SelectAllPortalCards_Click"
                                                        Height="26" Margin="0,0,2,0" Content="表示中全選択"/>
                                                <Button Grid.Column="1" Click="PortalDeselectCurrentPage_Click"
                                                        Height="26" Margin="2,0,0,0" Content="表示中解除"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. キーワード検索 -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <StackPanel>
                                            <TextBlock Text="キーワード検索" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="PortalSearchBox"
                                                         Text="{Binding OnlinePluginSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Click="PortalClearSearch_Click"
                                                        Width="24" Height="28" Margin="2,0,0,0"
                                                        ToolTip="検索クリア">
                                                    <Path Width="10" Height="10" Stretch="Uniform"
                                                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                          Fill="{DynamicResource TextBrush}"/>
                                                </Button>
                                                <Button Grid.Column="2" Click="PortalSearch_Click"
                                                        Width="28" Height="28" Margin="2,0,0,0"
                                                        ToolTip="検索">
                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                          Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                                          Fill="{DynamicResource TextBrush}"/>
                                                </Button>
                                            </Grid>
                                            <Button Click="PortalRefresh_Click" Height="28" Padding="8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                                                          Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                                          Fill="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="更新" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. カテゴリ / タイプフィルター -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <Expander Header="カテゴリ" IsExpanded="True" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                            <StackPanel Margin="0,4,0,0">
                                                <DockPanel Margin="0,2,0,6">
                                                    <TextBlock Text="一括設定" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Click="SelectAllTypeFilters_Click" Padding="4,1" Margin="0,0,2,0" Content="全選択" FontSize="10" FontWeight="Normal"/>
                                                        <Button Click="ClearAllTypeFilters_Click" Padding="4,1" Content="全解除" FontSize="10" FontWeight="Normal"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding PluginTypeFilters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding DisplayTextWithCount}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Click="PluginTypeFilter_Click"
                                                                      FontWeight="Normal"
                                                                      Margin="0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <!-- 4. 配布サイト種別 (動的一覧・全サイト名分類) -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <Expander Header="配布サイト" IsExpanded="True" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                            <StackPanel Margin="0,4,0,0">
                                                <DockPanel Margin="0,2,0,6">
                                                    <TextBlock Text="一括設定" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Click="SelectAllSiteFilters_Click" Padding="4,1" Margin="0,0,2,0" Content="全選択" FontSize="10" FontWeight="Normal"/>
                                                        <Button Click="ClearAllSiteFilters_Click" Padding="4,1" Content="全解除" FontSize="10" FontWeight="Normal"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding PluginSiteFilters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding DisplayTextWithCount}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Click="PluginSiteFilter_Click"
                                                                      FontWeight="Normal"
                                                                      Margin="0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <!-- 5. 状況 (インストール状況コンボボックス) -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <StackPanel>
                                            <TextBlock Text="状況" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <ComboBox SelectedIndex="{Binding PortalInstallFilterIndex}"
                                                      SelectionChanged="PortalInstallFilter_Changed" Height="26">
                                                <ComboBoxItem Content="すべて"/>
                                                <ComboBoxItem Content="インストール済み"/>
                                                <ComboBoxItem Content="未インストール"/>
                                                <ComboBoxItem Content="更新あり"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. 配布ステータス (コンボボックス化) -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <StackPanel>
                                            <TextBlock Text="配布ステータス" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <ComboBox SelectedIndex="{Binding PortalStatusIndex}"
                                                      SelectionChanged="PortalStatusFilter_Changed" Height="26">
                                                <ComboBoxItem Content="すべて"/>
                                                <ComboBoxItem Content="配布中"/>
                                                <ComboBoxItem Content="配布終了"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. GitHub/BOOTH外部検知 -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <StackPanel>
                                            <TextBlock Text="外部検知プラグイン" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock Text="GitHub" Margin="0,0,0,2"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                            <ComboBox x:Name="GitHubExtraCombo"
                                                      SelectedIndex="{Binding PortalGitHubExtraIndex}"
                                                      SelectionChanged="PortalExtraFilter_Changed"
                                                      Height="26" Margin="0,0,0,6">
                                                <ComboBoxItem Content="非表示"/>
                                                <ComboBoxItem Content="表示"/>
                                                <ComboBoxItem Content="のみ表示"/>
                                            </ComboBox>
                                            <TextBlock Text="Booth" Margin="0,0,0,2"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                            <ComboBox x:Name="BoothExtraCombo"
                                                      SelectedIndex="{Binding PortalBoothExtraIndex}"
                                                      SelectionChanged="PortalExtraFilter_Changed"
                                                      Height="26">
                                                <ComboBoxItem Content="非表示"/>
                                                <ComboBoxItem Content="表示"/>
                                                <ComboBoxItem Content="のみ表示"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- 7. 並び替え & 1ページ件数 -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <StackPanel>
                                            <TextBlock Text="並び替え" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="SortFieldCombo"
                                                          SelectedIndex="{Binding PortalSortFieldIndex}"
                                                          SelectionChanged="PortalSort_Changed" Height="26">
                                                    <ComboBoxItem Content="公開日"/>
                                                    <ComboBoxItem Content="更新日"/>
                                                    <ComboBoxItem Content="名前"/>
                                                    <ComboBoxItem Content="作者"/>
                                                    <ComboBoxItem Content="カテゴリ"/>
                                                    <ComboBoxItem Content="価格"/>
                                                    <ComboBoxItem Content="配布元"/>
                                                </ComboBox>
                                                <Button x:Name="SortAscBtn"
                                                        Grid.Column="1" Width="28" Height="26" Margin="4,0,0,0"
                                                        Click="PortalSortOrder_Click"
                                                        ToolTip="昇順/降順">
                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                          Data="M10,13V11H18V13H10M10,19V17H14V19H10M10,7V5H22V7H10M6,17H8.5L5,20.5L1.5,17H4V7H1.5L5,3.5L8.5,7H6V17Z"
                                                          Fill="{DynamicResource TextBrush}"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="1ページの件数" Margin="0,0,0,2"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                            <ComboBox x:Name="PageSizeCombo"
                                                      SelectedIndex="{Binding PortalPageSizeIndex}"
                                                      SelectionChanged="PortalPageSize_Changed" Height="26">
                                                <ComboBoxItem Content="5"/>
                                                <ComboBoxItem Content="10"/>
                                                <ComboBoxItem Content="20"/>
                                                <ComboBoxItem Content="50"/>
                                                <ComboBoxItem Content="100"/>
                                                <ComboBoxItem Content="全表示"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- 8. フィルターリセット & フッター情報 -->
                                    <Border Style="{StaticResource SideGroupStyle}">
                                        <StackPanel>
                                            <Button Click="ResetPortalFilters_Click" Content="フィルターをリセット"
                                                    Height="28" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding PortalFilteredVsTotalText}"
                                                       FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Ymm4LatestVersionText}"
                                                       FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            <GridSplitter Grid.Column="1" Width="4"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeWE"/>

                            <!-- 右メイン領域 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- カードScrollViewer -->
                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              x:Name="PortalScrollViewer"
                                              SizeChanged="PortalScrollViewer_SizeChanged">
                                    <ItemsControl x:Name="PortalCardPanel"
                                                  ItemsSource="{Binding OnlinePlugins}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel x:Name="PortalWrapPanel"
                                                           IsItemsHost="True"
                                                           Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- カード本体 -->
                                                <Border Style="{StaticResource PortalCardStyle}"
                                                        Width="{Binding DataContext.PortalCardWidth, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                                                        MinWidth="240" MinHeight="180">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                             <!-- 上帯 -->
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- 中央 -->
                                                            <RowDefinition Height="*"/>
                                                            <!-- 下帯 -->
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- 上帯: クリックで選択可能、直下と同じ背景色 -->
                                                        <Border Grid.Row="0"
                                                                Background="Transparent"
                                                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="8,6"
                                                                Cursor="Hand"
                                                                MouseLeftButtonUp="PortalCardHeader_Click">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- 選択チェックボックス -->
                                                                <CheckBox Grid.Column="0"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          VerticalAlignment="Center"
                                                                          Click="PortalCardCheck_Click"/>
                                                                <TextBlock Grid.Column="1" Text="選択"
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0,8,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                                <!-- タイプタグ -->
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding DisplayType}"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource SubTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <!-- サイトタグ -->
                                                                <Border Grid.Column="3"
                                                                        Style="{StaticResource TagBorderStyle}">
                                                                    <TextBlock Text="{Binding SiteTag}"
                                                                               FontSize="10"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 本文エリア: クリックで詳細ダイアログを表示 -->
                                                        <StackPanel Grid.Row="1" Margin="8,6,8,6" Cursor="Hand"
                                                                    Background="Transparent"
                                                                    MouseLeftButtonUp="PortalCardHeader_Click">
                                                            <!-- プラグイン名 -->
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Bold" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,0,2"/>
                                                            <!-- 作者 + バージョン or 価格 -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                <Path Width="11" Height="11" Stretch="Uniform"
                                                                      Margin="0,0,3,0" VerticalAlignment="Center"
                                                                      Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                                                      Fill="{DynamicResource SubTextBrush}"/>
                                                                <TextBlock Text="{Binding Author}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource SubTextBrush}"
                                                                           Margin="0,0,6,0"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <Border Style="{StaticResource TagBorderStyle}">
                                                                    <TextBlock Text="{Binding VersionOrPrice}"
                                                                               FontSize="10"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <!-- 公開日 & 更新日 -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <Path Width="11" Height="11" Stretch="Uniform"
                                                                      Margin="0,0,3,0" VerticalAlignment="Center"
                                                                      Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,13H12V18H17V13Z"
                                                                      Fill="{DynamicResource SubTextBrush}"/>
                                                                <TextBlock Text="{Binding DisplayPublishedAt}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource SubTextBrush}"/>
                                                            </StackPanel>
                                                            <!-- 説明 -->
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource SubTextBrush}"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="44"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,0,4"/>
                                                            <!-- タグ一覧 -->
                                                            <ItemsControl ItemsSource="{Binding Tags}"
                                                                          Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource TagBorderStyle}" Margin="0,0,3,3">
                                                                            <TextBlock Text="{Binding}" FontSize="9"
                                                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- 下帯: アクション -->
                                                        <Border Grid.Row="2"
                                                                Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                                Opacity="0.8"
                                                                Padding="6,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- アクションエリア (通常時全幅、更新あり時はバージョン選択と更新ボタンで半分ずつ) -->
                                                                <Grid Grid.Column="0">
                                                                    <!-- 更新なし時: 通常のボタン -->
                                                                    <Button Click="PortalCardPrimaryAction_Click"
                                                                            Height="26" Padding="6,0">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                                                  Margin="0,0,4,0"
                                                                                  Data="M6,2A3,3 0 0,1 9,5C9,6.28 8.19,7.38 7.06,7.82C7.15,8.09 7.2,8.34 7.2,8.6C7.2,10 5.96,11.2 4.8,11.97V14.03C6.24,14.39 7.2,15.66 7.2,17.2C7.2,19 5.96,20 4.8,20C3.64,20 2,19 2,17.2C2,15.66 2.96,14.39 4.4,14.03V11.97C2.96,11.61 2,10.34 2,8.6C2,6.8 3.64,5.8 4.8,5.8C4.9,5.8 5,5.81 5.1,5.82C5.04,5.55 5,5.28 5,5A3,3 0 0,1 8,2M6,17.2C6,16.36 5.44,15.8 4.8,15.8C4.16,15.8 3.6,16.36 3.6,17.2C3.6,18 4.16,18.6 4.8,18.6C5.44,18.6 6,18 6,17.2M4.8,7.4C4.16,7.4 3.6,8 3.6,8.6C3.6,9.24 4.16,9.8 4.8,9.8C5.44,9.8 6,9.24 6,8.6C6,8 5.44,7.4 4.8,7.4M16.8,5.8C15.64,5.8 14.4,6.8 14.4,8.6C14.4,10.34 15.36,11.61 16.8,11.97V22H18.4V11.97C19.84,11.61 20.8,10.34 20.8,8.6C20.8,6.8 19.16,5.8 17.2,5.8H16.8M18.4,7.4C19.04,7.4 19.6,8 19.6,8.6C19.6,9.24 19.04,9.8 18.4,9.8C17.76,9.8 17.2,9.24 17.2,8.6C17.2,8 17.76,7.4 18.4,7.4Z"
                                                                                  Fill="{DynamicResource TextBrush}"/>
                                                                            <TextBlock Text="{Binding PrimaryActionLabel}"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <!-- 更新あり時: 幅半分にバージョン選択 + 残り半分に更新ボタン -->
                                                                    <Grid>
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- 左半分: バージョン選択 -->
                                                                        <Button Grid.Column="0"
                                                                                Click="PortalCardPrimaryAction_Click"
                                                                                Height="26" Padding="2,0" Margin="0,0,2,0"
                                                                                ToolTip="{Binding PrimaryActionLabel}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Width="10" Height="10" Stretch="Uniform" Margin="0,0,2,0"
                                                                                      Data="M6,2A3,3 0 0,1 9,5C9,6.28 8.19,7.38 7.06,7.82C7.15,8.09 7.2,8.34 7.2,8.6C7.2,10 5.96,11.2 4.8,11.97V14.03C6.24,14.39 7.2,15.66 7.2,17.2C7.2,19 5.96,20 4.8,20C3.64,20 2,19 2,17.2C2,15.66 2.96,14.39 4.4,14.03V11.97C2.96,11.61 2,10.34 2,8.6C2,6.8 3.64,5.8 4.8,5.8C4.9,5.8 5,5.81 5.1,5.82C5.04,5.55 5,5.28 5,5A3,3 0 0,1 8,2M6,17.2C6,16.36 5.44,15.8 4.8,15.8C4.16,15.8 3.6,16.36 3.6,17.2C3.6,18 4.16,18.6 4.8,18.6C5.44,18.6 6,18 6,17.2M4.8,7.4C4.16,7.4 3.6,8 3.6,8.6C3.6,9.24 4.16,9.8 4.8,9.8C5.44,9.8 6,9.24 6,8.6C6,8 5.44,7.4 4.8,7.4M16.8,5.8C15.64,5.8 14.4,6.8 14.4,8.6C14.4,10.34 15.36,11.61 16.8,11.97V22H18.4V11.97C19.84,11.61 20.8,10.34 20.8,8.6C20.8,6.8 19.16,5.8 17.2,5.8H16.8M18.4,7.4C19.04,7.4 19.6,8 19.6,8.6C19.6,9.24 19.04,9.8 18.4,9.8C17.76,9.8 17.2,9.24 17.2,8.6C17.2,8 17.76,7.4 18.4,7.4Z"
                                                                                      Fill="{DynamicResource TextBrush}"/>
                                                                                <TextBlock Text="バージョン" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <!-- 右半分: 更新ボタン -->
                                                                        <Button Grid.Column="1"
                                                                                Click="PortalCardUpdate_Click"
                                                                                Height="26" Padding="2,0" Margin="2,0,0,0"
                                                                                ToolTip="最新版に更新">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,2,0"
                                                                                      Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                                                                      Fill="{DynamicResource TextBrush}"/>
                                                                                <TextBlock Text="更新" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Grid>
                                                                </Grid>
                                                                <!-- 詳細(i)ボタン -->
                                                                <Button Grid.Column="1"
                                                                        Click="PortalCardInfo_Click"
                                                                        Width="28" Height="26" Margin="4,0,0,0"
                                                                        ToolTip="詳細情報">
                                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                                          Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                                                          Fill="{DynamicResource TextBrush}"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- ページネーション -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                        BorderThickness="0,1,0,0"
                                        Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左: 件数表示 -->
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SubTextBrush}">
                                            <Run Text="{Binding PortalTotalCount}"/>
                                            <Run Text="件中"/>
                                            <Run Text="{Binding PortalDisplayStart}"/>
                                            <Run Text="-"/>
                                            <Run Text="{Binding PortalDisplayEnd}"/>
                                            <Run Text="件表示"/>
                                        </TextBlock>

                                        <!-- 中: ページネーション -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Click="PortalFirstPage_Click" Width="28" Height="26"
                                                    ToolTip="最初のページ" Margin="2,0">
                                                <Path Width="12" Height="12" Stretch="Uniform"
                                                      Data="M18.41,16.59L13.82,12L18.41,7.41L17,6L11,12L17,18L18.41,16.59M6,6H8V18H6V6Z"
                                                      Fill="{DynamicResource TextBrush}"/>
                                            </Button>
                                            <Button Click="PortalPrevPage_Click" Width="28" Height="26"
                                                    ToolTip="前のページ" Margin="2,0">
                                                <Path Width="12" Height="12" Stretch="Uniform"
                                                      Data="M15.41,16.59L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.59Z"
                                                      Fill="{DynamicResource TextBrush}"/>
                                            </Button>
                                            <TextBlock Text="ページ" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                            <TextBox x:Name="PageNumberBox" Width="40" Height="26"
                                                     Text="{Binding PortalCurrentPage}"
                                                     VerticalContentAlignment="Center"
                                                     TextAlignment="Center"
                                                     KeyDown="PageNumberBox_KeyDown"/>
                                            <TextBlock VerticalAlignment="Center" Margin="2,0">
                                                <Run Text="/"/>
                                                <Run Text="{Binding PortalTotalPages}"/>
                                            </TextBlock>
                                            <Button Click="PortalNextPage_Click" Width="28" Height="26"
                                                    ToolTip="次のページ" Margin="2,0">
                                                <Path Width="12" Height="12" Stretch="Uniform"
                                                      Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z"
                                                      Fill="{DynamicResource TextBrush}"/>
                                            </Button>
                                            <Button Click="PortalLastPage_Click" Width="28" Height="26"
                                                    ToolTip="最後のページ" Margin="2,0">
                                                <Path Width="12" Height="12" Stretch="Uniform"
                                                      Data="M5.59,7.41L10.18,12L5.59,16.59L7,18L13,12L7,6L5.59,7.41M16,6H18V18H16V6Z"
                                                      Fill="{DynamicResource TextBrush}"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- 右: ページ内全選択 -->
                                        <Button Grid.Column="2" Click="SelectAllPortalCards_Click"
                                                Height="26" Padding="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="現在ページを全選択" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 4. 設定タブ (フラット・枠囲み廃止・ComboBox統一) -->
                <TabItem Header="設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">
                            <TextBlock Text="設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                            <!-- 設定項目: フラット行配置（左端ラベル、右端コントロール） -->
                            <Grid Margin="0,4,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- 外観テーマ -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="外観" VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          SelectedValue="{Binding SelectedTheme}"
                                          SelectedValuePath="Tag" Height="28"
                                          HorizontalAlignment="Right" Width="150">
                                    <ComboBoxItem Content="Windows標準" Tag="{x:Static local:AppTheme.Windows}"/>
                                    <ComboBoxItem Content="ライト" Tag="{x:Static local:AppTheme.Light}"/>
                                    <ComboBoxItem Content="ダーク" Tag="{x:Static local:AppTheme.Dark}"/>
                                    <ComboBoxItem Content="ブラック" Tag="{x:Static local:AppTheme.Black}"/>
                                </ComboBox>

                                <!-- 言語設定 -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="言語設定" VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          DisplayMemberPath="Name"
                                          Height="28" HorizontalAlignment="Right" Width="150"/>

                                <!-- YMM4起動時にHubを終了する -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{x:Static local:Translate.ExitHubOnYmm4Start}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <CheckBox Grid.Row="2" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding CloseOnLaunch}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                <!-- Github以外からのダウンロード時サイトを開く -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{x:Static local:Translate.AutoOpenSiteOnBulkDownload}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <CheckBox Grid.Row="3" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding AutoOpenSiteOnBulkDownload}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                <!-- フォルダパスを非表示にする -->
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="{x:Static local:Translate.HideExePath}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <CheckBox Grid.Row="4" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding HideExePath}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- 編集データフォルダ (フラット) -->
                            <DockPanel Margin="0,16,0,6" LastChildFill="False">
                                <TextBlock Text="編集データフォルダ" FontWeight="Bold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Click="AddProjectDir_Click" Width="28" Height="26"
                                            Margin="0,0,4,0" ToolTip="追加">
                                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                              Stretch="Uniform" Width="12" Height="12"
                                              Fill="{DynamicResource TextBrush}"/>
                                    </Button>
                                    <Button Click="RemoveProjectDir_Click" Width="28" Height="26"
                                            ToolTip="削除">
                                        <Path Data="M19,13H5V11H19V13Z"
                                              Stretch="Uniform" Width="12" Height="12"
                                              Fill="{DynamicResource TextBrush}"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="ProjectDirListBox" ItemsSource="{Binding ProjectDirectories}"
                                     Height="110" Margin="0,0,0,20">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource MaskedPathConverter}">
                                                    <Binding Path="."/>
                                                    <Binding Path="DataContext.HideExePath" RelativeSource="{RelativeSource AncestorType=local:MainWindow}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 除外フォルダ (フラット) -->
                            <DockPanel Margin="0,4,0,6" LastChildFill="False">
                                <TextBlock Text="除外フォルダ" FontWeight="Bold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Click="AddExcludeDir_Click" Width="28" Height="26"
                                            Margin="0,0,4,0" ToolTip="追加">
                                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                              Stretch="Uniform" Width="12" Height="12"
                                              Fill="{DynamicResource TextBrush}"/>
                                    </Button>
                                    <Button Click="RemoveExcludeDir_Click" Width="28" Height="26"
                                            ToolTip="削除">
                                        <Path Data="M19,13H5V11H19V13Z"
                                              Stretch="Uniform" Width="12" Height="12"
                                              Fill="{DynamicResource TextBrush}"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="ExcludeDirListBox" ItemsSource="{Binding ExcludeDirectories}"
                                     Height="110">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource MaskedPathConverter}">
                                                    <Binding Path="."/>
                                                    <Binding Path="DataContext.HideExePath" RelativeSource="{RelativeSource AncestorType=local:MainWindow}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- アップデート -->
                            <DockPanel Margin="0,16,0,6" LastChildFill="False">
                                <TextBlock Text="アップデート" FontWeight="Bold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            </DockPanel>
                            <Border Style="{StaticResource SideGroupStyle}" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HubVersionText}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="YukkuriMovieMaker4Hub の更新を確認・実行します"
                                                   Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="CheckHubUpdate_Click" Content="アップデートを確認"
                                                Height="28" Padding="12,0" Margin="0,0,8,0"/>
                                        <Button Click="ExecuteHubUpdate_Click" Content="アップデートを実行"
                                                Height="28" Padding="14,0"
                                                Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ポータル選択バー（ポータルタブで選択数>0のとき表示） -->
            <Border Grid.Row="1"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="0,1,0,0"
                    Padding="8,4"
                    Visibility="{Binding PortalSelectionBarVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 選択状況テキスト -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0"
                              Data="M10,17L5,12L6.41,10.58L10,14.17L17.59,6.58L19,8M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z"
                              Fill="{DynamicResource TextBrush}"/>
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold">
                            <Run Text="{Binding PortalSelectedCount}"/>
                            <Run Text="件選択中"/>
                        </TextBlock>
                        <Path Width="14" Height="14" Stretch="Uniform" Margin="16,0,4,0"
                              Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"
                              Fill="{DynamicResource TextBrush}"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="GitHub:"/>
                            <Run Text="{Binding PortalGitHubCount}"/>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                            <Run Text="外部:"/>
                            <Run Text="{Binding PortalExternalCount}"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- 操作ボタン -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Click="PortalDeselectCurrentPage_Click" Height="26" Padding="8,0" Margin="0,0,6,0">
                            <TextBlock Text="表示中を解除" FontSize="11"/>
                        </Button>
                        <Button Click="PortalClearSelection_Click" Height="26" Padding="8,0" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="{DynamicResource TextBrush}"/>
                                <TextBlock Text="クリア" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BulkDownloadSelected_Click" Height="26" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                      Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                      Fill="{DynamicResource TextBrush}"/>
                                <TextBlock Text="一括ダウンロード実行" FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
